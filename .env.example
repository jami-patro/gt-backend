# Server
PORT=5050
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# MongoDB connection string
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=app

# Event details (shown on the landing page AND in every email)
EVENT_NAME=OEC Silver Jubilee 1997-2001 Batch Reunion
EVENT_DATE=2026-12-19
EVENT_VENUE=Bhubaneswar
# Optional Google Maps (or any) link to the venue.
EVENT_LOCATION_URL=
EVENT_TIME=5:00 PM – 10:00 PM (TBD)
# One or more contacts, comma-separated, as "Name - phone".
# e.g. "Mrunal Jena - 9876543210, Srikanta Patro - 9123456789"
EVENT_CONTACT=Mrunal Jena - 9876543210

# Default admin (created by: npm run seed:admin)
ADMIN_NAME=Reunion Admin
ADMIN_EMAIL=admin@reunion.com
ADMIN_PASSWORD=changeme123

# ---- Email --------------------------------------------------------------
# OPTION 1 (recommended, no domain): Gmail via App Password.
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=

RESEND_API_KEY=
# For Gmail leave blank; for Resend: "OEC Reunion <noreply@yourdomain.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=
