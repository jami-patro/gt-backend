# Server
PORT=5050
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
# In production set this to your Vercel frontend URL, e.g. https://gt-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# MongoDB connection string (your loyaltty Mongo). Point it at a dedicated DB.
# Example: mongodb://user:pass@165.22.138.253:27017/gettogether?authSource=admin
MONGO_URL=mongodb://localhost:27017/gettogether

# Event details
EVENT_NAME=Silver Jubilee Batch Reunion
EVENT_DATE=2026-12-19

# Default admin (created by: npm run seed:admin)
ADMIN_NAME=Reunion Admin
ADMIN_EMAIL=admin@reunion.com
ADMIN_PASSWORD=changeme123
